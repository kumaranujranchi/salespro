# Convex Configuration
# Copy this file to .env and fill in your actual values
# Get these values from your Convex dashboard:

VITE_CONVEX_URL=https://your-convex-project-url.convex.cloud
CONVEX_DEPLOYMENT=your-deployment-name

# Email configuration (Netlify Functions SMTP)
# Default is configured for Hostinger SMTP, but you can override these:
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-email@domain.com
EMAIL_PASS=your-email-password
