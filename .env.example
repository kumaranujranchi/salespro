# RealSalePro - AWS Lightsail Configuration
# Frontend API URL
VITE_API_URL=http://localhost:5001/api

# Backend auth (REQUIRED in production — generate with: openssl rand -hex 32)
JWT_SECRET=
JWT_TTL=7d

# Email SMTP configuration (Hostinger / Custom SMTP)
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=

# Meta / Facebook Integration
VITE_FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
