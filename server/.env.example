# PostgreSQL Database Connection URL (AWS RDS / Lightsail / Neon / Localhost)
# Example AWS RDS: postgresql://postgres:yourpassword@your-rds-endpoint.amazonaws.com:5432/salespro?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/salespro

# Server Port
PORT=5001

# Environment
NODE_ENV=production

# JWT Secret (for session tokens)
JWT_SECRET=realsalepro-jwt-secret-key-change-in-production

# Email SMTP configuration (For sending Security Codes / Password Reset)
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=

# Razorpay (Optional - for subscriptions)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
